root = Card([panel])
$selectedOptions = {}
$reviewFocus = "tradeoffs"
panel = ComparisonPanel("OpenUI workflow review", "Sample proposals \u00b7 openui-personal-library-v1 \u00b7 2026-10-28; recommendations are judgments.", [{"id": "comparison", "title": "Option comparison", "status": "proposed", "details": "Compare a bounded set of choices and discuss a shortlist.", "criteria": {"Scope": "Agent-fetched snapshots and supplied evidence", "Tradeoff": "Judgment still needs discussion"}, "recommendation": "Start here for a decision with named criteria."}, {"id": "plan-review", "title": "Plan review", "status": "proposed", "details": "Choose plan steps and assumptions to discuss before execution.", "criteria": {"Scope": "Supplied completion status stays separate from selection", "Tradeoff": "Selection does not authorize work"}}, {"id": "repository-review", "title": "Repository findings", "status": "proposed", "details": "Inspect and shortlist findings in a bounded repository snapshot.", "criteria": {"Scope": "Source revision and time accompany the snapshot", "Tradeoff": "No live refresh or execution"}}], $selectedOptions, $reviewFocus)
