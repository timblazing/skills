root = Card([header, intro, review, summary, comparison, recommendation, discussion])
$selectedOptions = {comparison: false, plan: false, repository: false, homelab: false}
$reviewFocus = "tradeoffs"
header = CardHeader("Choose the next OpenUI building blocks", "Decision review · OpenUI roadmap · 28 Oct 2026")
intro = TextContent("Which workflows should shape your smaller personal library? Shortlist the ones you would actually use. These are proposed scopes, not completed features.")
review = Form("decisionReview", controls, [shortlist, focus])
shortlist = FormControl("Shortlist workflows", CheckBoxGroup("selectedOptions", [CheckBoxItem("Option comparison", "Weigh implementation approaches and choose what to pursue.", "comparison"), CheckBoxItem("Plan review", "Inspect steps, challenge assumptions, and agree on scope.", "plan"), CheckBoxItem("Repository / PR review", "Discuss selected findings and changed files.", "repository"), CheckBoxItem("Homelab status", "Choose services to investigate from a health snapshot.", "homelab")], null, $selectedOptions))
focus = FormControl("Review focus", Select("reviewFocus", [SelectItem("tradeoffs", "Compare tradeoffs"), SelectItem("scope", "Define the smallest useful scope"), SelectItem("risks", "Challenge risks and assumptions"), SelectItem("sequence", "Recommend an implementation order")], null, null, $reviewFocus))
controls = Buttons(@Count(selected) > 0 ? [ask, clear] : [clear])
ask = Button("Ask agent about shortlist", @ToAssistant("Review my shortlisted OpenUI workflows. Focus: " + $reviewFocus + ". Explain your recommendation and ask about any missing constraints. Keep this to discussion until I choose the work to implement.", {decisionId: "openui-personal-library-v1", reviewFocus: $reviewFocus, selectedOptions: @Each(selected, "option", {id: option.id, title: option.title})}), "secondary")
clear = Button("Clear shortlist", @Set($selectedOptions, {comparison: false, plan: false, repository: false, homelab: false}), "tertiary")
summary = TextContent(@Count(selected) == 0 ? "Comparing all 4 workflows · nothing shortlisted" : "Comparing " + @Count(selected) + (@Count(selected) == 1 ? " shortlisted workflow" : " shortlisted workflows"))
comparison = Table([Col("Workflow", visible.title), Col("Smallest useful version", visible.scope), Col("Main tradeoff", visible.tradeoff)])
visible = @Count(selected) == 0 ? options : selected
selected = @Filter(options, "selected", "==", true)
options = [{id: "comparison", title: "Option comparison", scope: "Selectable options, explicit tradeoffs, concise discussion context.", tradeoff: "Reusable across tasks; option quality depends on the supplied evidence.", selected: $selectedOptions.comparison}, {id: "plan", title: "Plan review", scope: "Selectable steps, assumptions, and questions before implementation.", tradeoff: "Useful without live data; revised plans need a fresh snapshot.", selected: $selectedOptions.plan}, {id: "repository", title: "Repository / PR review", scope: "Agent-fetched file and finding snapshot with selection for discussion.", tradeoff: "Needs repository/revision provenance; findings become stale after edits.", selected: $selectedOptions.repository}, {id: "homelab", title: "Homelab status", scope: "Agent-fetched service snapshot with selection for investigation.", tradeoff: "Needs timestamps and read-only data access; refresh adds integration work.", selected: $selectedOptions.homelab}]
recommendation = TextContent("**Suggested starting point:** option comparison, then plan review. Both reuse the selection and discussion flow without adding a live-data integration. This is a recommendation, not a measured ranking.", "small")
discussion = TextContent("For a normal conversation, enable **Share selection**, wait until it is available, then type something like ‘Which of these would I use most?’ in T3. **Ask agent about shortlist** offers a focused prompt with T3 approval. Clearing the shortlist shows all workflows again.", "small")
