root = Card([header, intro, ranges, summary, chart, planner, note])
header = CardHeader("OpenUI, inside T3", "A real OpenUI Lang interface · sample data")
intro = TextContent("Change the range to update the chart locally. No extra model call is involved.")
$days = "7"
$goal = "Try OpenUI without building another chat app"
ranges = Buttons([Button("7 days", @Set($days, "7"), "secondary"), Button("30 days", @Set($days, "30"), "secondary"), Button("Reset", @Reset($days, $goal), "tertiary")])
summary = TextContent("Showing " + $days + " days · " + @Sum(values) + " sample tasks", "large-heavy")
values = $days == "7" ? [12, 8, 5] : [48, 32, 20]
chart = BarChart(["Codex", "Claude", "Shared"], [Series("Sample tasks", values)], "grouped", null, "Tasks", 210)
planner = Form("experiment", Buttons([Button("Preview agent handoff", @ToAssistant("Help me plan this OpenUI experiment", {goal: $goal, days: $days}), "secondary")]), [FormControl("What would you like to try?", Input("goal", "Describe an experiment", "text", null, $goal))])
note = TextContent("The handoff button displays an action payload you can paste into chat. Automatic submission to T3 is not connected.", "small")
