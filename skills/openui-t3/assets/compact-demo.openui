root = Card([CardHeader("OpenUI in T3", "MCP App connection test · sample data"), TextContent("Range controls update locally. Send to agent requests a user-approved message."), Button("7 days", @Set($days, "7"), "secondary"), Button("30 days", @Set($days, "30"), "secondary"), Button("Reset", @Reset($days, $goal), "tertiary"), TextContent("Showing " + $days + " days"), Input("goal", "Experiment description (editable)", $goal), Button("Send to agent", @ToAssistant("OpenUI handoff test: confirm that this interface message reached you, and repeat the experiment description and selected range. Do not change files or call tools for this test.", {goal: $goal, days: $days}), "secondary"), TextContent("T3 asks you to approve this message. Sample chart examples remain available through render_openui_legacy.", "small")])
$days = "7"
$goal = "Compare options for my next OpenUI experiment"
